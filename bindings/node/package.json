{
  "name": "@astars/native",
  "version": "0.0.0",
  "description": "napi-rs bindings for astars-core (spike; not the eventual `astars` package).",
  "main": "index.js",
  "types": "index.d.ts",
  "napi": {
    "binaryName": "astars-native",
    "targets": [
      "x86_64-apple-darwin",
      "aarch64-apple-darwin",
      "x86_64-unknown-linux-gnu",
      "aarch64-unknown-linux-gnu",
      "x86_64-pc-windows-msvc"
    ]
  },
  "devDependencies": {
    "@napi-rs/cli": "^3"
  },
  "scripts": {
    "build": "napi build --platform --release",
    "build:debug": "napi build --platform"
  }
}
